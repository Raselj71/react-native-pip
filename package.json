{
  "name": "@raselj5060/react-native-pip",
  "version": "1.0.0",
  "description": "Android picture-in-picture for Expo and React Native apps: custom actions, auto-enter, and a leave-app fallback.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "src",
    "!src/**/__tests__",
    "android/build.gradle",
    "android/src",
    "plugin/build",
    "app.plugin.js",
    "expo-module.config.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p plugin/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p plugin/tsconfig.json --noEmit",
    "test": "jest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["react-native", "expo", "expo-module", "android", "pip", "picture-in-picture"],
  "author": "Rasel Ahammed (https://github.com/Raselj71)",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Raselj71/react-native-pip.git" },
  "homepage": "https://github.com/Raselj71/react-native-pip#readme",
  "bugs": { "url": "https://github.com/Raselj71/react-native-pip/issues" },
  "publishConfig": { "access": "public" },
  "peerDependencies": { "expo": "*", "react": "*", "react-native": "*" },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "expo": "57.0.7",
    "jest": "29.7.0",
    "jest-expo": "57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": ["/node_modules/", "/build/"]
  }
}
